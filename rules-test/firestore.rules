rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =================================================================================
    // Helper Functions
    // =================================================================================

    function isAuthenticated() { return request.auth != null; }

    // The signed-in user's own document. Firestore reads it once per request,
    // even though several helpers below use it.
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // PHASE 1: .get('role', 'member') so an account with no role reads as a
    // member instead of causing an error.
    function getUserRole() { return me().get('role', 'member'); }

    // PHASE 1 STEP 4: the signed-in user's gym. Accounts made before
    // multi-gym support have no gymId and belong to Team Flo.
    function myGymId() { return me().get('gymId', 'teamflo'); }

    // PHASE 1 STEP 4: signed in AND a member of this gym.
    function inGym(gymId) { return isAuthenticated() && myGymId() == gymId; }

    // PHASE 1 STEP 4: is another user's document in my gym?
    function sameGym(userData) { return userData.get('gymId', 'teamflo') == myGymId(); }

    function userInMyGym(userId) {
      return sameGym(get(/databases/$(database)/documents/users/$(userId)).data);
    }

    // PHASE 1: roles from the plan doc. 'admin' is the old name for owner and
    // keeps working until existing accounts are moved to 'owner'.
    // A role only ever applies inside the user's own gym: every rule below
    // also checks inGym() or sameGym().
    //
    //   isAdmin()      owner, manager        schedule, moderation, member edits
    //   isInstructor() + instructor          promotions, class edits
    //   isStaff()      + front desk          attendance and walk-ins
    function isAdmin() { return getUserRole() in ['owner', 'manager', 'admin']; }

    function isInstructor() { return getUserRole() in ['owner', 'manager', 'admin', 'instructor']; }

    function isStaff() { return getUserRole() in ['owner', 'manager', 'admin', 'instructor', 'front_desk']; }

    function isClassInstructor() { return resource.data.instructorUid == request.auth.uid; }

    function isCreator() { return request.auth.uid == resource.data.userId; }

    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // PHASE 1: role and gym can only be changed by Cloud Functions
    // (setUserRole, the migration). The Admin SDK skips these rules.
    // Uses .get(key, null) so a field that is missing before and after
    // counts as unchanged.
    function protectedUserFieldsUnchanged() {
      let before = resource.data;
      let after = request.resource.data;
      return after.get('role', null) == before.get('role', null) &&
             after.get('gymId', null) == before.get('gymId', null) &&
             after.get('roleUpdatedBy', null) == before.get('roleUpdatedBy', null) &&
             after.get('roleUpdatedAt', null) == before.get('roleUpdatedAt', null);
    }

    // =================================================================================
    // PHASE 1 STEP 4: gym data rules
    //
    // Posts, classes and attendance can live in two places:
    //   posts, classes, classHistory          Team Flo before migration
    //   gyms/{gymId}/posts, classes, ...      every scoped gym
    // Both places use these same functions, so the rules can't drift apart.
    // =================================================================================

    // ----- Posts -----
    function canReadPosts(gymId) { return inGym(gymId); }

    function canCreatePost(gymId) {
      return inGym(gymId) && request.resource.data.userId == request.auth.uid;
    }

    function canUpdatePost(gymId) {
      return inGym(gymId) && (isCreator() || isAdmin() || onlyChanges(['likedBy', 'commentCount']));
    }

    // Authors can always delete their own posts and comments (account
    // deletion relies on this). Owners and managers can delete any in their gym.
    function canDeletePost(gymId) { return isCreator() || (inGym(gymId) && isAdmin()); }

    // ----- Comments -----
    function canUpdateComment(gymId) {
      return inGym(gymId) && (isCreator() || onlyChanges(['likedBy', 'commentCount']));
    }

    // ----- Classes -----
    function canReadClasses(gymId) { return inGym(gymId); }

    function canCreateOrDeleteClass(gymId) { return inGym(gymId) && isAdmin(); }

    function canUpdateClass(gymId) {
      return inGym(gymId) &&
        (isAdmin() || isClassInstructor() || onlyChanges(['attendees', 'sessionDate']));
    }

    // ----- Class attendance history -----
    // Members can open their own records (even ones that don't exist yet,
    // which the Join transaction needs). Staff can open any.
    function canGetHistory(gymId, recordId) {
      return inGym(gymId) && (recordId.matches('.*_' + request.auth.uid) || isStaff());
    }

    // Members can query only their own records. Staff can query any.
    function canListHistory(gymId) {
      return inGym(gymId) && (resource.data.userId == request.auth.uid || isStaff());
    }

    // Members create their own sign-up only: correct ID, signedUp, not a walk-in.
    // Staff can create anything (walk-ins).
    function canCreateHistory(gymId, recordId) {
      return inGym(gymId) && (
        isStaff() || (
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.status == 'signedUp' &&
          request.resource.data.walkIn == false &&
          recordId == request.resource.data.classId + '_' +
                      request.resource.data.sessionDate + '_' +
                      request.auth.uid
        )
      );
    }

    // Only staff can confirm attendance or mark no-shows
    function canUpdateHistory(gymId) { return inGym(gymId) && isStaff(); }

    // Members can remove their own sign-up until it's confirmed
    function canDeleteHistory(gymId) {
      return inGym(gymId) && (
        isStaff() || (
          resource.data.userId == request.auth.uid &&
          resource.data.status == 'signedUp'
        )
      );
    }

    // =================================================================================
    // Validation Functions
    // (Not called by any rule right now. Kept for later use.)
    // =================================================================================
    function validateUserData() {
      let data = request.resource.data;
      return data.keys().hasAll(['uid', 'name', 'email', 'beltRank', 'role', 'createdAt']) &&
        data.uid is string &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.email is string && data.email.matches('.*@.*\\..*') &&
        data.role is string && data.role in ['member', 'instructor', 'admin'] &&
        data.createdAt is timestamp;
    }

    function onlyAllowedUserFields() {
      let incomingData = request.resource.data;
      let existingData = resource.data;
      return incomingData.uid == existingData.uid &&
             incomingData.role == existingData.role &&
             incomingData.createdAt == existingData.createdAt;
    }

    function validateClassData() {
      let data = request.resource.data;
      return data.keys().hasAll(['className', 'time', 'instructor', 'day']) &&
             data.className is string && data.className.size() > 0 &&
             data.time is string &&
             data.instructor is string &&
             data.day is string;
    }

    function validatePostData() {
      let data = request.resource.data;
      return data.keys().hasAll(['userId', 'content', 'createdAt']) &&
             data.content is string &&
             data.content.size() > 0 && data.content.size() <= 2000 &&
             data.createdAt is timestamp;
    }

    function validateCommentData() {
      let data = request.resource.data;
      return data.keys().hasAll(['userId', 'content', 'createdAt']) &&
             data.content is string &&
             data.content.size() > 0 &&
             data.content.size() <= 2000 &&
             data.createdAt is timestamp;
    }

    function validateJournalData() {
      let data = request.resource.data;
      return data.keys().hasAll(['userId', 'date']) &&
        data.userId is string &&
        data.date is timestamp &&
        (!('technique') || data.technique is string) &&
        (!('position') || data.position is string) &&
        (!('submissions') || data.submissions is number) &&
        (!('submissionAttempts') || data.submissionAttempts is number) &&
        (!('timesSubmitted') || data.timesSubmitted is number) &&
        (!('energy') || data.energy is number) &&
        (!('sleep') || data.sleep is number) &&
        (!('water') || data.water is number) &&
        (!('food') || data.food is number) &&
        (!('generalNotes') || data.generalNotes is string) &&
        (!('classesAttended') || data.classesAttended is list) &&
        (!('photoUrl') || data.photoUrl is string) &&
        (!('createdAt') || data.createdAt is timestamp) &&
        (!('updatedAt') || data.updatedAt is timestamp);
    }

    function validateAttendanceData() {
      let data = request.resource.data;
      return data.keys().hasAll(['userId', 'classId', 'timestamp']) &&
             data.userId is string &&
             data.classId is string &&
             data.timestamp is timestamp;
    }

    // =================================================================================
    // Collections
    // =================================================================================

    // ----- Gyms -----
    match /gyms/{gymId} {
      // PHASE 1 STEP 4: members read only their own gym's settings.
      allow read: if inGym(gymId);
      // Changed from the Firebase console or Cloud Functions for now.
      allow write: if false;

      // Gym data (gyms with dataScoped: true)
      match /posts/{postId} {
        allow read: if canReadPosts(gymId);
        allow create: if canCreatePost(gymId);
        allow update: if canUpdatePost(gymId);
        allow delete: if canDeletePost(gymId);

        match /comments/{commentId} {
          allow read: if canReadPosts(gymId);
          allow create: if canCreatePost(gymId);
          allow update: if canUpdateComment(gymId);
          allow delete: if canDeletePost(gymId);
        }
      }

      match /classes/{classId} {
        allow read: if canReadClasses(gymId);
        allow create, delete: if canCreateOrDeleteClass(gymId);
        allow update: if canUpdateClass(gymId);
      }

      // PHASE 1 STEP 6: the gym's Instagram card (latest post)
      match /instagram/{docId} {
        allow read: if inGym(gymId);
        allow write: if inGym(gymId) && isAdmin();
      }

      match /classHistory/{recordId} {
        allow get: if canGetHistory(gymId, recordId);
        allow list: if canListHistory(gymId);
        allow create: if canCreateHistory(gymId, recordId);
        allow update: if canUpdateHistory(gymId);
        allow delete: if canDeleteHistory(gymId);
      }
    }

    // ----- Team Flo data before migration (shared collections) -----
    // PHASE 1 STEP 4: only Team Flo members can see or change these.
    // After the step 7 migration they are no longer used.

    match /posts/{postId} {
      allow read: if canReadPosts('teamflo');
      allow create: if canCreatePost('teamflo');
      allow update: if canUpdatePost('teamflo');
      allow delete: if canDeletePost('teamflo');

      match /comments/{commentId} {
        allow read: if canReadPosts('teamflo');
        allow create: if canCreatePost('teamflo');
        allow update: if canUpdateComment('teamflo');
        allow delete: if canDeletePost('teamflo');
      }
    }

    match /classes/{classId} {
      allow read: if canReadClasses('teamflo');
      allow create, delete: if canCreateOrDeleteClass('teamflo');
      allow update: if canUpdateClass('teamflo');
    }

    match /classHistory/{recordId} {
      allow get: if canGetHistory('teamflo', recordId);
      allow list: if canListHistory('teamflo');
      allow create: if canCreateHistory('teamflo', recordId);
      allow update: if canUpdateHistory('teamflo');
      allow delete: if canDeleteHistory('teamflo');
    }

    // Instagram feed (public)
    match /instagram/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ----- Journals -----
    // Gym-wide technique list (collection group query on 'journal').
    // PHASE 1 STEP 4: other gyms must filter by their own gymId.
    // TEMPORARY until step 7: Team Flo entries have no gymId yet, so Team Flo
    // members can run the query without a filter. Step 7 removes this.
    match /{path=**}/journal/{entryId} {
      allow read: if isAuthenticated() &&
        (myGymId() == 'teamflo' || resource.data.gymId == myGymId());
    }

    // ----- Users -----
    match /users/{uid} {
      // PHASE 1 STEP 4: open your own profile, or a member of your gym.
      // resource == null: opening a profile that doesn't exist (for example
      // a member who deleted their account) still returns "not found", the
      // same as before, instead of a permission error. No data is shown.
      allow get: if isAuthenticated() &&
        (request.auth.uid == uid || resource == null || sameGym(resource.data));

      // PHASE 1 STEP 4: member lists (mentions, staff portal) must filter by
      // gymId. TEMPORARY until step 7: Team Flo accounts have no gymId yet,
      // so Team Flo members can list without a filter. Step 7 removes this.
      allow list: if isAuthenticated() &&
        (myGymId() == 'teamflo' || resource.data.gymId == myGymId());

      // New accounts start as 'member' (or no role) with no gym.
      // The gym is set by a Cloud Function, never by the app.
      allow create: if request.auth.uid == uid &&
        request.resource.data.get('role', 'member') == 'member' &&
        !('gymId' in request.resource.data);

      // Users edit their own doc. Owners and managers can also edit other
      // members OF THEIR OWN GYM (PHASE 1 STEP 4). Nobody can change
      // role or gym from the app.
      allow update: if isAuthenticated() &&
        protectedUserFieldsUnchanged() &&
        (request.auth.uid == uid || (isAdmin() && sameGym(resource.data)));

      // Account deletion (GDPR)
      allow delete: if request.auth.uid == uid;

      // Journal entries
      // PHASE 1 STEP 4: readable by members of the same gym (was: anyone
      // signed in). Owners and managers can only edit their own gym's.
      match /journal/{entryId} {
        allow read: if isAuthenticated() &&
          (request.auth.uid == uid || userInMyGym(uid));
        allow write: if request.auth.uid == uid || (isAdmin() && userInMyGym(uid));
      }

      match /journalEntries/{entryId} {
        allow read: if request.auth.uid == uid;
        allow create: if request.auth.uid == uid;
        allow update: if request.auth.uid == uid;
        allow delete: if request.auth.uid == uid;
      }
    }
  }
}